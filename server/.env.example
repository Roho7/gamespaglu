# Connect as the scoped role, NOT with SUPABASE_SERVICE_KEY. service_role
# bypasses RLS on every table in the project, including officepaglu's customers
# and orders — a word-game server must not be able to read those.
#
# Use SESSION mode (port 5432), not the transaction pooler (6543): this process
# is long-lived and uses SELECT ... FOR UPDATE transactions.
DATABASE_URL=postgres://gp_app:PASSWORD@db.PROJECT.supabase.co:5432/postgres

PORT=8080
NODE_ENV=development
# Comma-separated. The browser sends an Origin on the websocket handshake.
ALLOWED_ORIGINS=http://localhost:3000,https://gamespaglu.com,https://www.gamespaglu.com
