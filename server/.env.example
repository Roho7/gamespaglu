# Set to memory to keep rooms in this process and skip Redis, for playing locally. Refused in production.
ROOM_STORE=

# REST URL and token from the Upstash console. The database is in sin. Not needed with ROOM_STORE=memory.
REDIS_URL=https://example.upstash.io
REDIS_REST_TOKEN=

PORT=8080
NODE_ENV=development
# Comma-separated. The browser sends an Origin on the websocket handshake.
ALLOWED_ORIGINS=http://localhost:3000,https://gamespaglu.com,https://www.gamespaglu.com
