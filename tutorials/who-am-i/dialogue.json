    },
    {
      "id": "play-6",
      "section": "gameplay",
      "subject": "house-rule",
      "text": "You can keep asking as long as the answers are yes. Get a no, and it's the next person's turn.",
      "scene": {
        "shot": "ask-4",
        "graphic": {
          "type": "list",
