{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!docs' ':!scripts' ':!.claude' ':!server/Dockerfile' ':!server/fly.toml' ':!server/migrations' ':!server/scripts'"
}
